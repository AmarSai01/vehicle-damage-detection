# Vehicle Damage Detection & Classification
# Copy this file to `.env` and adjust values for your machine.
# Never commit `.env` with secrets or absolute personal paths you do not want shared.

# -----------------------------------------------------------------------------
# Dataset (CarDD — obtain legally via official license consent)
# Official site: https://cardd-ustc.github.io/
# Set this to the extracted CarDD root folder on your machine.
# -----------------------------------------------------------------------------
# Set to your authorized extracted CarDD_COCO folder (example):
# DATASET_ROOT=C:/path/to/CarDD_release/CarDD_COCO
DATASET_ROOT=./data/CarDD

# -----------------------------------------------------------------------------
# Paths (relative to project root unless absolute)
# -----------------------------------------------------------------------------
ARTIFACTS_DIR=./ml/artifacts
MODELS_DIR=./ml/artifacts/models
EVALUATION_DIR=./ml/artifacts/evaluation
SPLITS_DIR=./ml/artifacts/splits
HISTORY_DIR=./ml/artifacts/history
CHECKPOINTS_DIR=./ml/artifacts/checkpoints

# -----------------------------------------------------------------------------
# Training defaults
# -----------------------------------------------------------------------------
IMAGE_SIZE=224
BATCH_SIZE=32
EPOCHS=50
LEARNING_RATE=0.001
SEED=42
TRAIN_RATIO=0.70
VAL_RATIO=0.15
TEST_RATIO=0.15
NUM_WORKERS=0

# -----------------------------------------------------------------------------
# Backend / API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.bmp,.webp

# -----------------------------------------------------------------------------
# Frontend (Vite uses VITE_ prefix)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
